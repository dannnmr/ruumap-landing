# URL canónica de producción, sin slash final (ej. https://ruumap.com).
# Server-side únicamente — nunca se expone al cliente ni se infiere de un host
# provisto por el proveedor de hosting (Vercel/Cloudflare). Requerida en todo
# ambiente: el build falla si falta (ver lib/site-config.ts).
SITE_URL=https://ruumap.com

# Habilita la indexación en buscadores para este ambiente. Solo el ambiente de
# producción real debe fijarlo en "true" (comparación estricta). Cualquier
# otro valor, o no definirla, deja el sitio en noindex,nofollow por defecto —
# fail-closed intencional para no indexar previews/staging por accidente.
SITE_INDEXABLE=false

# ID de medición de Google Analytics 4 (gtag.js), client-side. Si se deja
# vacío o sin definir, Analytics permanece completamente inerte: sin script,
# sin llamadas a gtag, sin errores.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
